<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- The one place the release number is written: the window reads it off
         the assembly and setup.iss reads it off the built exe. -->
    <Version>1.0.0</Version>
    <!-- A single-file publish otherwise leaves WPF's native libraries out of the
         exe without copying them beside it, and the app dies with a
         DllNotFoundException as soon as a window is subclassed. The installer
         ships only the exe, so the exe has to carry them. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!-- This project has no explicit file list, so it would otherwise compile the
       test project's sources into the app as well. The tests build on their own
       and reference this project; they are deliberately not in a solution file,
       because build_exe.bat publishes whatever it finds in this folder and a
       test assembly must never land in ReleaseBuild. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>

</Project>
