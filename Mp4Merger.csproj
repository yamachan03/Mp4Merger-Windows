<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- The one place the release number is written: the window reads it off
         the assembly and setup.iss reads it off the built exe. -->
    <Version>1.0.0</Version>
    <!-- A single-file publish otherwise leaves WPF's native libraries out of the
         exe without copying them beside it, and the app dies with a
         DllNotFoundException as soon as a window is subclassed. The installer
         ships only the exe, so the exe has to carry them. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
