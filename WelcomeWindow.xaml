<Window x:Class="Mp4Merger.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MP4 Merger Setup" Height="300" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#18181C" Foreground="#E0E0E6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center">
            <TextBlock Text="MP4 Merger" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="初期設定 / Initial Setup" FontSize="12" Foreground="#8A8A8F" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Settings Options -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Language Selection -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="言語 / Language:" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E6"/>
                </StackPanel>
                 <ComboBox x:Name="LanguageCombo" Grid.Column="1" Height="28" Padding="5,2" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="日本語" Tag="ja" IsSelected="True"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                 </ComboBox>
            </Grid>

            <!-- Theme Selection -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ThemeLabel" Text="テーマ / Theme:" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0E6"/>
                </StackPanel>
                <ComboBox x:Name="ThemeCombo" Grid.Column="1" Height="28" Padding="5,2">
                    <ComboBoxItem x:Name="ThemeDarkItem" Content="ダークモード (Dark)" Tag="dark" IsSelected="True"/>
                    <ComboBoxItem x:Name="ThemeLightItem" Content="ライトモード (Light)" Tag="light"/>
                    <ComboBoxItem x:Name="ThemeAutoItem" Content="自動切り替え (Auto)" Tag="auto"/>
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Start Button -->
        <Button x:Name="StartBtn" Grid.Row="2" Content="開始 / Start" Height="36" Width="150" 
                Background="#0E62CD" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" 
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="StartBtn_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
